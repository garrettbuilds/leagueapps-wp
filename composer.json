{
	"name": "garrettbuilds/leagueapps-wp",
	"description": "Publish LeagueApps Teams and Divisions on your own WordPress site. Read-only, one-way, and it never touches member contact details.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5"
	},
	"autoload": {
		"psr-4": {
			"LeagueAppsWP\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"LeagueAppsWP\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit --testsuite unit",
		"test:unit": "phpunit --testsuite unit",
		"test:integration": "phpunit --testsuite integration"
	},
	"config": {
		"sort-packages": true
	}
}
